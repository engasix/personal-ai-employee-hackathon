# Vault Configuration
VAULT_PATH="./AI_Employee_Vault"

# Orchestrator Settings
CHECK_INTERVAL=30  # How often to check for new tasks (seconds)
MAX_CONCURRENT_TASKS=3  # Maximum Claude processes running at once
CLAUDE_TIMEOUT=300  # Maximum time for Claude to complete a task (seconds)

# Safety Settings
DRY_RUN=false  # Set to 'true' to test without actually invoking Claude
DEBUG_MODE=false  # Set to 'true' for verbose logging

# Scheduling
ENABLE_CEO_BRIEFING=true
CEO_BRIEFING_DAY=sunday
CEO_BRIEFING_TIME=20:00

# Retry Settings
MAX_TASK_RETRIES=3
RETRY_DELAY=60  # Seconds between retries

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_RETENTION_DAYS=30

# Claude Code Settings
CLAUDE_MODEL=claude-sonnet-4
CLAUDE_API_KEY=  # If needed for Claude Code Router

# Notification Settings (optional)
ENABLE_NOTIFICATIONS=false
NOTIFICATION_EMAIL=
NOTIFICATION_WEBHOOK=

